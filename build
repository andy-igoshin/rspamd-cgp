#!/bin/bash

export GOPATH="${HOME}/src/rspamd-cgp"

# если на целевой ОС не совпадает glibc, то собираем без зависимостей.
# результирующий файл, возможно, получится медленнее и большего размера.
export CGO_ENABLED=0

if   [ "$1" == "fmt" ]; then
    go fmt $*
elif [ "$1" == "tidy" ]; then
    go mod tidy
elif [ "$1" == "update" ]; then
    echo "update..."
    go get -u ./...
    go mod tidy
elif [ "$1" == "vet" ]; then
    echo "vet..."
    go vet ./...
else
    go build
fi
